# Optional API keys for the quantitative trading framework.
#
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in the keys you have.
# 3. NEVER commit `.env`; it is ignored by Git.
#
# Without keys:
#   - price ingestion and reports still work
#   - fundamentals / news / FRED macro data are skipped or use fallbacks
#
# Get your keys from:
# - Finnhub:   https://finnhub.io/register
# - Marketaux: https://www.marketaux.com/account/dashboard
# - FRED:      https://fredaccount.stlouisfed.org/apikeys

FINNHUB_API_KEY=your_finnhub_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
FRED_API_KEY=your_fred_api_key_here
